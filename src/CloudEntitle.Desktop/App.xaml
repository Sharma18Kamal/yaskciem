<Application x:Class="CloudEntitle.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CloudEntitle.Desktop"
             xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels"
             xmlns:views="clr-namespace:CloudEntitle.Desktop.Views">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#EAF3FC" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#DCEBFA" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#BDD2E8" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#193B5D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#55718B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F79BF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#28765E" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#B43D4C" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#6589AD" BlurRadius="7" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EAF3FC"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderBrush" Value="#C8DCF0"/><Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#C9E1F8"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E5F1FD"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="#B7D1EB"/><Setter Property="Padding" Value="14,7"/></Style>
        <Style x:Key="WindowChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#EEF6FF"/><Setter Property="BorderBrush" Value="#C9DDF0"/><Setter Property="FontSize" Value="18"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Background" Value="#BEDCF7"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="#82B6E5"/></Style>
        <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="#E3F0FD"/><Setter Property="BorderBrush" Value="#B8D4EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="9,5"/></Style>
        <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="Width" Value="28"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="CardLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="CardValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource MetricCard}"><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style x:Key="EmptyStateCard" TargetType="Border" BasedOn="{StaticResource MetricCard}"><Setter Property="MinHeight" Value="220"/><Setter Property="Padding" Value="40"/></Style>
        <Style x:Key="SearchBox" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="RowBackground" Value="{StaticResource PanelBrush}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/><Setter Property="CanUserAddRows" Value="False"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource SidebarBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}"><views:WorkspaceView/></DataTemplate>
    </Application.Resources>
</Application>

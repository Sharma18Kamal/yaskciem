<UserControl x:Class="CloudEntitle.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Scan Now" Command="{Binding ScanCommand}" MinWidth="100" Style="{StaticResource PrimaryButton}" ToolTip="Scan the connected cloud provider using read-only CLI access"/>
                <Button Grid.Column="1" Content="Stop Scan" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}" MinWidth="100" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Cancel the active scan and terminate its provider CLI request"/>
                <Button Grid.Column="2" Content="Generate Report" Command="{Binding GenerateReportCommand}" MinWidth="120" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Choose a folder and save findings as JSON or CSV"/>
                <Button Grid.Column="3" Content="Discover accounts" Command="{Binding DiscoverAccountsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="List accounts available through the currently connected cloud provider"/>
                <TextBlock Grid.Column="4" Text="{Binding DataContext.CloudConnectionStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="180" MaxHeight="48" ToolTip="Cloud CLI connection status"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding ComplianceFrameworks}" SelectedItem="{Binding SelectedComplianceFramework, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="145" Margin="8,0,0,0" ToolTip="Compliance framework for the exported evidence bundle"/>
                <Button Grid.Column="6" Content="Export evidence bundle" Command="{Binding ExportComplianceBundleCommand}" IsEnabled="{Binding CanExportComplianceBundle}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Export organization-scoped controls, evidence, gaps, and assessment metadata"/>
                <TextBlock Grid.Column="7" Text="{Binding ScanStatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" ToolTip="{Binding ScanStatusMessage}"/>
            </Grid>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Padding" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x2601;&#x231B;" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Cloud scan in progress" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScanWaitingMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Height="6" IsIndeterminate="True" Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" ToolTip="Scan in progress"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Expander Header="{Binding AccountSelectionMessage}" IsExpanded="False" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <Button Content="Select all" Command="{Binding SelectAllAccountsCommand}" Style="{StaticResource QuietButton}"/>
                        <Button Content="Select none" Command="{Binding SelectNoAccountsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AvailableAccounts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" MaxHeight="240" MinHeight="80" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Scan" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Permission set" Binding="{Binding PermissionSet}" IsReadOnly="True" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ComplianceExportStatus}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="2" Rows="4">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CLOUD ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CloudAccounts}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Identities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Resources}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ENTITLEMENTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Entitlements}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PRIVILEGED IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding PrivilegedIdentities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RISK FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding RiskFindings}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CRITICAL FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CriticalFindings}" Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LAST SCAN" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding LastScan}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY PROVIDER" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsByProvider}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY SEVERITY" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsBySeverity}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="ACCESS DECISIONS" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding AccessByDecision}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeedbackViewModel}">
            <StackPanel MaxWidth="820">
                <Border Style="{StaticResource SectionCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="YOUR FEEDBACK *" Style="{StaticResource CardLabel}"/>
                        <TextBox Text="{Binding FeedbackText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxLength="5000" Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource LineBrush}" Padding="12" Margin="0,8,0,20"/>
                        <TextBlock Text="SUGGESTIONS *" Style="{StaticResource CardLabel}"/>
                        <TextBox Text="{Binding SuggestionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxLength="5000" Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource LineBrush}" Padding="12" Margin="0,8,0,16"/>
                        <TextBlock Text="No username, email address, or phone number is requested. Submissions are stored locally on this device." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Submit Feedback" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Style="{StaticResource PrimaryButton}"/>
                            <TextBlock Text="{Binding SubmissionMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search resources"/>
                <DataGrid ItemsSource="{Binding Resources}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="Resource ID" Binding="{Binding ResourceId}" Width="220"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No scanned resources match this search. Run a scan from Dashboard to discover resources." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IdentitiesViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search identities"/>
                <DataGrid ItemsSource="{Binding Identities}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding CloudProvider}" Width="110"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding IdentityType}" Width="110"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="Principal ID" Binding="{Binding PrincipalId}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding IsPrivileged}" Width="90"/>
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No scanned identities match this search. Run a scan from Dashboard to discover identities." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntitlementsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search entitlements"/>
                <DataGrid ItemsSource="{Binding Entitlements}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180"/>
                        <DataGridTextColumn Header="Grant" Binding="{Binding Grant}" Width="220"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
                        <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="110"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No entitlement assignments or live roles and permissions are available." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EffectiveAccessViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search effective access"/>
                <TextBlock Text="{Binding DataCoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <DataGrid ItemsSource="{Binding AccessRecords}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="170"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="160"/>
                        <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="170"/>
                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="*"/>
                        <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="90"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="90"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="190"/>
                        <DataGridTextColumn Header="Last used" Binding="{Binding LastUsed}" Width="150"/>
                        <DataGridTextColumn Header="Last changed" Binding="{Binding LastChanged}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding Privileged}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No modeled effective-access records match this search." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="PERMISSION SIMULATOR" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding SimulatorCoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Principal" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorPrincipals}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorPrincipalId, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Resource" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorResources}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorResourceId, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Permission" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorPermissions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorPermissionId, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Evaluate" Command="{Binding SimulatePermissionCommand}" IsEnabled="{Binding CanSimulatePermission}" Style="{StaticResource PrimaryButton}"/>
                            <TextBlock Text="{Binding SimulationStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSimulationResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SimulationResult.Decision}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SimulationResult.EvaluationStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SimulationResult.Provider}" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="  |  " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SimulationResult.Principal}" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="  |  " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SimulationResult.Resource}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SimulationResult.Permission}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Source}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.AccessPath}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Evidence}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Diagnostics}" Foreground="{StaticResource CriticalBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccessPathExplorerViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search access paths"/>
                <TextBlock Text="{Binding CoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="520" CanUserSortColumns="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                            <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="170"/>
                            <DataGridTextColumn Header="Path type" Binding="{Binding PathType}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding Privileged}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PATH EVIDENCE" Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedPath.Confidence}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding SelectedVisualNodes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                            <Border Style="{StaticResource SectionCard}" Width="138" MinHeight="112" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Sequence, StringFormat={}{0}.}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Width="96" VerticalAlignment="Center" Margin="4,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Relationship}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="→" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Relationship}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="BLAST RADIUS" Style="{StaticResource CardLabel}" Margin="0,2,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="RELATED ASSIGNMENTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.RelatedAssignments}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Margin="4,0"><TextBlock Text="RELATED ROLES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.RelatedRoles}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Margin="8,0,0,0"><TextBlock Text="OBSERVED RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.ObservedResources}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding BlastRadius.Assessment}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scope: " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding BlastRadius.Scope}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BlastRadius.Caveat}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SelectedPath.Evidence}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="No provider-reported access paths match this search." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RiskFindingsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search risk findings"/>
                <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding PriorityScore}" Width="80"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="150"/>
                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="150"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>

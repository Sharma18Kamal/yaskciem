                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="80"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="Interval (min)" Binding="{Binding IntervalMinutes}" Width="90"/>
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
                                        <DataGridTextColumn Header="Next run" Binding="{Binding NextRunAtUtc, StringFormat=g}" Width="140"/>
                                        <DataGridTextColumn Header="Last successful" Binding="{Binding LastSuccessfulScanAtUtc, StringFormat=g}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Run selected now" Command="{Binding RunScanNowCommand}" IsEnabled="{Binding CanRunScheduledScan}" Style="{StaticResource QuietButton}" ToolTip="Queue an immediate full scan for the selected account"/>
                                    <Button Content="Pause / resume" Command="{Binding ToggleScanScheduleCommand}" IsEnabled="{Binding CanToggleScanSchedule}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Pause or resume the selected account scan schedule"/>
                                </StackPanel>
                                <TextBlock Text="RECENT ACCOUNT SCAN JOBS" Style="{StaticResource CardLabel}" Margin="0,12,0,0"/>
                                <DataGrid ItemsSource="{Binding ScanJobs}" SelectedItem="{Binding SelectedScanJob, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="60" MaxHeight="180" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="80"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="85"/>
                                        <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="70"/>
                                        <DataGridTextColumn Header="Queued" Binding="{Binding QueuedAtUtc, StringFormat=g}" Width="140"/>
                                        <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMilliseconds}" Width="90"/>
                                        <DataGridTextColumn Header="Last outcome" Binding="{Binding LastError}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Cancel selected job" Command="{Binding CancelScanJobCommand}" IsEnabled="{Binding CanCancelScanJob}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" ToolTip="Request cancellation of the selected queued or running scan job"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="CLOUD ACCOUNT BINDINGS" Style="{StaticResource CardLabel}"/>

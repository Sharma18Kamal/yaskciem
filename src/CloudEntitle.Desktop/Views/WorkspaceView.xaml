                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SCANNED ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedAccountCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedIdentities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedResources}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedFindings}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CRITICAL / EFFECTIVE ACCESS" Style="{StaticResource CardLabel}"/><TextBlock Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"><Run Text="{Binding ConsolidatedCriticalFindings, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ConsolidatedEffectiveAccess, Mode=OneWay}"/></TextBlock></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding ConsolidatedCoverage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

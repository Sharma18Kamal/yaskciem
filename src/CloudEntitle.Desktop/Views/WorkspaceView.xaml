        <DataTemplate DataType="{x:Type vm:CloudAccountsViewModel}">
            <StackPanel>
                <TextBlock Text="CONNECT A CLOUD PROVIDER" Style="{StaticResource CardLabel}"/>
                <TextBlock Text="Sign-in opens in the provider's CLI. Connecting authenticates only; go to Dashboard and select Scan Now to fetch cloud data. Use organization-approved read-only identities; credentials stay with the CLI. Azure Entra/PIM enrichment needs tenant-approved Microsoft Graph read consent. Disconnect signs out of the shared CLI session and may affect other tools." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap"/>

                            <StackPanel>
                                <TextBlock Text="SHARED SCAN HISTORY" Style="{StaticResource CardLabel}"/>
                                <Button Content="Publish latest scan data" Command="{Binding PublishSharedScanSummaryCommand}" IsEnabled="{Binding CanPublishSharedScanSummary}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" ToolTip="Share normalized inventory, access paths, findings, counts, and source coverage for this organization's bound accounts."/>
                                <TextBlock Text="{Binding SharedScanSummaryStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <DataGrid ItemsSource="{Binding SharedScanSummaries}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="55" MaxHeight="140" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAtUtc, StringFormat=g}" Width="150"/>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                        <DataGridTextColumn Header="Accounts" Binding="{Binding Accounts.Count}" Width="75"/>
                                        <DataGridTextColumn Header="Identities" Binding="{Binding Identities}" Width="75"/>
                                        <DataGridTextColumn Header="Resources" Binding="{Binding Resources}" Width="75"/>
                                        <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="75"/>
                                        <DataGridTextColumn Header="Critical" Binding="{Binding CriticalFindings}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="LATEST SHARED FINDINGS" Style="{StaticResource CardLabel}" Margin="0,12,0,0"/>
                                <DataGrid ItemsSource="{Binding SharedFindings}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="55" MaxHeight="180" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="80"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding ExternalAccountId}" Width="120"/>
                                        <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" Width="210"/>
                                        <DataGridTextColumn Header="Evidence JSON" Binding="{Binding PayloadJson}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SCHEDULED FULL SCANS" Style="{StaticResource CardLabel}"/>

<UserControl x:Class="CloudEntitle.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="ToolTip" Value="Click sortable column headers to reorder rows. Select a row where selection is enabled."/>
        </Style>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <StackPanel>
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Scan Now" Command="{Binding ScanCommand}" MinWidth="100" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Scan all connected providers and selected accounts or Kubernetes contexts using read-only access."/>
                <Button Content="Stop Scan" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}" MinWidth="100" Style="{StaticResource QuietButton}" Margin="0,0,8,8" ToolTip="Cancel the active scan and terminate its provider CLI request"/>
                <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" MinWidth="120" Style="{StaticResource QuietButton}" Margin="0,0,8,8" ToolTip="Choose a folder and save findings as JSON or CSV"/>
                <Button Content="Discover accounts" Command="{Binding DiscoverAccountsCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" ToolTip="Refresh connected-provider accounts and local Kubernetes contexts for scan selection."/>
                <TextBlock Text="{Binding DataContext.CloudConnectionStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,8" TextWrapping="Wrap" MaxWidth="180" ToolTip="Cloud CLI connection status"/>
                <ComboBox ItemsSource="{Binding ComplianceFrameworks}" SelectedItem="{Binding SelectedComplianceFramework, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="145" Margin="0,0,8,8" ToolTip="Compliance framework for the exported evidence bundle"/>
                <Button Content="Export evidence bundle" Command="{Binding ExportComplianceBundleCommand}" IsEnabled="{Binding CanExportComplianceBundle}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" ToolTip="Export organization-scoped controls, evidence, gaps, and assessment metadata"/>
                <TextBlock Text="{Binding ScanStatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,8" TextWrapping="Wrap" MaxWidth="240" ToolTip="{Binding ScanStatusMessage}"/>
            </WrapPanel>
            <Expander Header="Standards and assessment history" IsExpanded="False" Margin="0,0,0,14" ToolTip="Choose compliance frameworks, record time-limited control exceptions, and review saved assessments.">
                <StackPanel>
                    <TextBlock Text="Standards included in the assessment crosswalk" Style="{StaticResource CardLabel}" Margin="0,8,0,4"/>
                    <ItemsControl ItemsSource="{Binding ComplianceStandardOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4,18,4" ToolTip="Include this framework in the next compliance assessment and evidence export."/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="CONTROL EXCEPTIONS" Style="{StaticResource CardLabel}" Margin="0,14,0,4"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ExceptionControlId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Internal CIEM control ID" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ExceptionReference, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exception or ticket reference" Margin="5,0"/>
                        <TextBox Grid.Column="2" Text="{Binding ExceptionRecordedBy, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exception recorded by" Margin="5,0"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ExceptionExpiresAt, Mode=TwoWay}" ToolTip="Exception expiry date" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBox Text="{Binding ExceptionRationale, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exception rationale" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox Text="{Binding ExceptionEvidenceReference, UpdateSourceTrigger=PropertyChanged}" ToolTip="Approval evidence reference (optional)" Width="280"/>
                        <Button Content="Add exception" Command="{Binding AddComplianceExceptionCommand}" IsEnabled="{Binding CanAddComplianceException}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Record an approved control exception with an owner, rationale, evidence reference, and future expiry date."/>
                        <Button Content="Remove selected" Command="{Binding RemoveComplianceExceptionCommand}" IsEnabled="{Binding CanRemoveComplianceException}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Remove the selected local control exception."/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ComplianceExceptionDrafts}" SelectedItem="{Binding SelectedComplianceException, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="150" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="110"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="110"/>
                            <DataGridTextColumn Header="Recorded by" Binding="{Binding RecordedBy}" Width="150"/>
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc, StringFormat=d}" Width="110"/>
                            <DataGridTextColumn Header="Rationale" Binding="{Binding Rationale}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Exports are signed evidence snapshots, not a compliance certification or auditor attestation." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Load assessment history" Command="{Binding LoadComplianceHistoryCommand}" Style="{StaticResource QuietButton}" ToolTip="Load saved assessment results for the selected framework."/>
                        <TextBlock Text="{Binding ComplianceHistoryStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ComplianceHistory}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding AssessedAt}" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SuccessBrush}" Margin="10,0,0,0"><Run Text="Pass "/><Run Text="{Binding Passed, Mode=OneWay}"/></TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource CriticalBrush}" Margin="10,0,0,0"><Run Text="Fail "/><Run Text="{Binding Failed, Mode=OneWay}"/></TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"><Run Text="Partial "/><Run Text="{Binding Partial, Mode=OneWay}"/></TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"><Run Text="Exceptions "/><Run Text="{Binding ExceptionCount, Mode=OneWay}"/></TextBlock>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"><Run Text="Not assessed "/><Run Text="{Binding NotAssessed, Mode=OneWay}"/><Run Text=" | mapping "/><Run Text="{Binding MappingCatalogVersion, Mode=OneWay}"/></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Padding" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x2601;" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,2,0"/>
                            <TextBlock Text="&#x231B;" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ScanHourglassFlipStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="180" Duration="0:0:0.55" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ScanHourglassFlipStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="Cloud scan in progress" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScanStatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ScanElapsedText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Height="6" IsIndeterminate="True" Background="{StaticResource LineBrush}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" ToolTip="Scan in progress"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Expander Header="{Binding AccountSelectionMessage}" IsExpanded="False" Margin="0,0,0,14" ToolTip="Choose cloud accounts and Kubernetes contexts included in the next scan.">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <Button Content="Select all" Command="{Binding SelectAllAccountsCommand}" Style="{StaticResource QuietButton}" ToolTip="Include every discovered cloud account and Kubernetes context in the next scan."/>
                        <Button Content="Select none" Command="{Binding SelectNoAccountsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Clear all account and context selections."/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AvailableAccounts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" MaxHeight="240" MinHeight="80" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Scan" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Permission set" Binding="{Binding PermissionSet}" IsReadOnly="True" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ComplianceExportStatus}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="2" Rows="4">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CLOUD ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CloudAccounts}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Identities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Resources}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ENTITLEMENTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Entitlements}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PRIVILEGED IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding PrivilegedIdentities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RISK FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding RiskFindings}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CRITICAL FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CriticalFindings}" Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LAST SCAN" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding LastScan}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="3" Rows="2" Margin="0,4,0,8">
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding EvidenceAgeDetails}"><StackPanel><TextBlock Text="EVIDENCE AGE" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding EvidenceAge}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding EvidenceAgeDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding SourceCoverageDetails}"><StackPanel><TextBlock Text="SOURCE COVERAGE" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding SourceCoverageSummary}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding SourceCoverageDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding UnsupportedPermissionSourceDetails}"><StackPanel><TextBlock Text="UNSUPPORTED PERMISSION SOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding UnsupportedPermissionSourceCount}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding UnsupportedPermissionSourceDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding AttributionDetails}"><StackPanel><TextBlock Text="ATTRIBUTION CONFIDENCE" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding AttributionConfidence}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding AttributionDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding UnknownEvaluationDetails}"><StackPanel><TextBlock Text="UNKNOWN EVALUATIONS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding UnknownEvaluationTotal}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding UnknownEvaluationDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" ToolTip="{Binding UnsupportedEvaluationDetails}"><StackPanel><TextBlock Text="UNSUPPORTED EVALUATIONS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding UnsupportedEvaluationTotal}" Style="{StaticResource CardValue}"/><TextBlock Text="{Binding UnsupportedEvaluationDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY PROVIDER" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsByProvider}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY SEVERITY" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsBySeverity}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="ACCESS DECISIONS" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding AccessByDecision}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeedbackViewModel}">
            <StackPanel MaxWidth="820">
                <Border Style="{StaticResource SectionCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="YOUR FEEDBACK *" Style="{StaticResource CardLabel}"/>
                        <TextBox Text="{Binding FeedbackText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxLength="5000" Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource LineBrush}" Padding="12" Margin="0,8,0,20" ToolTip="Required. Describe your experience; do not include passwords, access keys, or other secrets."/>
                        <TextBlock Text="SUGGESTIONS *" Style="{StaticResource CardLabel}"/>
                        <TextBox Text="{Binding SuggestionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxLength="5000" Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource LineBrush}" Padding="12" Margin="0,8,0,16" ToolTip="Required. Suggest improvements; submissions are stored locally and do not request contact details."/>
                        <TextBlock Text="No username, email address, or phone number is requested. Submissions are stored locally on this device." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Submit Feedback" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Style="{StaticResource PrimaryButton}" ToolTip="Save this feedback and suggestion locally on this device."/>
                            <TextBlock Text="{Binding SubmissionMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search resources"/>
                <DataGrid ItemsSource="{Binding Resources}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="Resource ID" Binding="{Binding ResourceId}" Width="220"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No scanned resources match this search. Run a scan from Dashboard to discover resources." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IdentitiesViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search identities"/>
                <DataGrid ItemsSource="{Binding Identities}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding CloudProvider}" Width="110"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding IdentityType}" Width="110"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="Principal ID" Binding="{Binding PrincipalId}" Width="*"/>
                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerSummary}" Width="180"/>
                        <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding IsPrivileged}" Width="90"/>
                        <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityAt}" Width="160"/>
                        <DataGridTextColumn Header="Workload observed" Binding="{Binding LastObservedWorkloadAtUtc}" Width="160"/>
                        <DataGridTextColumn Header="Credential rotated" Binding="{Binding CredentialLastRotatedAtUtc}" Width="160"/>
                        <DataGridTextColumn Header="Credential expires" Binding="{Binding CredentialExpiresAtUtc}" Width="160"/>
                        <DataGridTextColumn Header="Federation trust" Binding="{Binding FederationSummary}" Width="240"/>
                        <DataGridCheckBoxColumn Header="Federation verified" Binding="{Binding FederationTrustVerified}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No scanned identities match this search. Run a scan from Dashboard to discover identities." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntitlementsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search entitlements"/>
                <DataGrid ItemsSource="{Binding Entitlements}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180"/>
                        <DataGridTextColumn Header="Grant" Binding="{Binding Grant}" Width="220"/>
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
                        <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="110"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No entitlement assignments or live roles and permissions are available." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EffectiveAccessViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search effective access"/>
                <TextBlock Text="{Binding DataCoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <DataGrid ItemsSource="{Binding AccessRecords}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="170"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="160"/>
                        <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="170"/>
                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="*"/>
                        <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="90"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="90"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="190"/>
                        <DataGridTextColumn Header="Last used" Binding="{Binding LastUsed}" Width="150"/>
                        <DataGridTextColumn Header="Last changed" Binding="{Binding LastChanged}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding Privileged}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No modeled effective-access records match this search." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="PERMISSION SIMULATOR" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding SimulatorCoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Principal" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorPrincipals}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorPrincipalId, Mode=TwoWay}" ToolTip="Choose the principal whose scanned grants will be evaluated."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Resource" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorResources}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorResourceId, Mode=TwoWay}" ToolTip="Choose the scanned resource to evaluate access against."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Permission" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SimulatorPermissions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SimulatorPermissionId, Mode=TwoWay}" ToolTip="Choose the permission to evaluate using the current scan snapshot."/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Evaluate" Command="{Binding SimulatePermissionCommand}" IsEnabled="{Binding CanSimulatePermission}" Style="{StaticResource PrimaryButton}" ToolTip="Evaluate the selected principal, resource, and permission against stored scan evidence only; no cloud call is made."/>
                            <TextBlock Text="{Binding SimulationStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSimulationResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SimulationResult.Decision}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SimulationResult.EvaluationStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SimulationResult.Provider}" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="  |  " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SimulationResult.Principal}" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="  |  " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SimulationResult.Resource}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SimulationResult.Permission}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Source}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.AccessPath}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Evidence}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SimulationResult.Diagnostics}" Foreground="{StaticResource CriticalBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccessPathExplorerViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search access paths"/>
                <TextBlock Text="{Binding CoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="520" CanUserSortColumns="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                            <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="170"/>
                            <DataGridTextColumn Header="Path type" Binding="{Binding PathType}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding Privileged}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PATH EVIDENCE" Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedPath.Confidence}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding SelectedVisualNodes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                            <Border Style="{StaticResource SectionCard}" Width="138" MinHeight="112" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Sequence, StringFormat={}{0}.}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Width="96" VerticalAlignment="Center" Margin="4,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Relationship}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="→" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Relationship}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="BLAST RADIUS" Style="{StaticResource CardLabel}" Margin="0,2,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="RELATED ASSIGNMENTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.RelatedAssignments}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Margin="4,0"><TextBlock Text="RELATED ROLES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.RelatedRoles}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Margin="8,0,0,0"><TextBlock Text="OBSERVED RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BlastRadius.ObservedResources}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding BlastRadius.Assessment}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scope: " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding BlastRadius.Scope}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BlastRadius.Caveat}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SelectedPath.Evidence}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="No provider-reported access paths match this search." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RiskFindingsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search risk findings"/>
                <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding PriorityScore}" Width="80"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="150"/>
                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="150"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                        <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No risk findings match this search." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudAccountsViewModel}">
            <StackPanel>
                <TextBlock Text="CONNECT A CLOUD PROVIDER" Style="{StaticResource CardLabel}"/>
                <TextBlock Text="Use dedicated, organization-approved read-only identities and grant access only at intended account scopes. CLI authentication is not proof of scan permissions: run a read-only scan and check source coverage for denied, partial, unavailable, and unsupported data. YASK-CIEM does not receive or store cloud credentials. Prefer short-lived or federated credentials where your provider supports them." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Refresh sign-in status" Command="{Binding RefreshConnectionsCommand}" Style="{StaticResource QuietButton}" ToolTip="Recheck authentication status in every configured provider CLI."/>
                    <TextBlock Text="{Binding CloudConnectionStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryBrush}" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CliName}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MinHeight="38" Margin="0,10,0,12"/>
                                    <TextBlock Text="LEAST-PRIVILEGE SETUP" Style="{StaticResource CardLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PermissionGuidance}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MinHeight="62" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding AccessValidationText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Connect" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource PrimaryButton}" ToolTip="Run the provider's interactive sign-in command"/>
                                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Stop using this provider in YASK-CIEM; provider CLI credentials may remain available to other tools."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource SectionCard}" Padding="18" Margin="0,8,0,14">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT DISCOVERY" Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Discover accessible accounts" Command="{Binding DiscoverAccountsCommand}" Style="{StaticResource QuietButton}" ToolTip="List account scopes visible to the selected CLI sessions. This does not validate all scan permissions."/>
                            <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="DISCOVERED ACCOUNTS AND PERMISSION SETS" Style="{StaticResource CardLabel}" Margin="0,4,0,10"/>
                        <DataGrid ItemsSource="{Binding DiscoveredAccounts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="320" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="220"/>
                                <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="150"/>
                                <DataGridTextColumn Header="CLI profile" Binding="{Binding Profile}" Width="150"/>
                                <DataGridTextColumn Header="Permission set" Binding="{Binding PermissionSet}" Width="170"/>
                                <DataGridTextColumn Header="Scan access" Binding="{Binding ScanAccess}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="An account listed here is visible to the current CLI identity; it is not proof that every inventory source is readable. AWS Organizations members are listed separately from accounts scanned through configured profiles. Prefer IAM Identity Center SSO profiles and configure access for each target account/permission set." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="LATEST PERMISSION AND SOURCE COVERAGE" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding LastCollectionText}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding SourceCoverage}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="280" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                                <DataGridTextColumn Header="Source / scope" Binding="{Binding DataSource}" Width="190"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Records" Binding="{Binding Records}" Width="75"/>
                                <DataGridTextColumn Header="Details / remediation hint" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Collected and NoData are successful query outcomes. Denied, Partial, Unavailable, Unsupported, and Skipped are distinct coverage states; none of the latter should be interpreted as safe or complete." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ConnectionGuidance}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="APPLICATION" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Version" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding ApplicationVersion}" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0" ToolTip="Version of the installed YASK-CIEM desktop application."/>
                        <TextBlock Text="Data location" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding DataLocation}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="LOCAL DATA BACKUP" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Back up or restore the local database, scan history, and workflow records. API credentials and webhook endpoints are excluded." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,8" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create backup" Command="{Binding CreateLocalBackupCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Create a checksummed archive of supported local data. CLI, ticketing, and webhook credentials are excluded."/>
                            <Button Content="Restore backup" Command="{Binding RestoreLocalBackupCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Replace current local records from a validated backup; confirmation is required and the app must be restarted."/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalDataBackupStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="DEMO MODE" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding DemoModeState}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Synthetic Azure, AWS, and GCP data is stored through the normal SQLite pipeline. No cloud APIs or credentials are used." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Load Demo Data" Command="{Binding LoadDemoDataCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Load synthetic Azure, AWS, and GCP records without contacting cloud services."/>
                            <Button Content="Reset Demo Data" Command="{Binding ResetDemoDataCommand}" Style="{StaticResource QuietButton}" Margin="10,0,0,0" ToolTip="Clear demo records and return to the normal workspace data."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="CONTINUOUS MONITORING" Style="{StaticResource CardLabel}"/>
                        <CheckBox Content="Enable scheduled scans" IsChecked="{Binding ScheduledScansEnabled, Mode=TwoWay}" Margin="0,12,0,8" ToolTip="Run serialized read-only scans at the selected interval while YASK-CIEM remains open."/>
                        <TextBlock Text="Scan interval" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4"/>
                        <ComboBox ItemsSource="{Binding ScanIntervals}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding SelectedScanIntervalMinutes, Mode=TwoWay}" ToolTip="Choose how often scans run, from 5 minutes to 7 days."/>
                        <Button Content="Save schedule" Command="{Binding SaveMonitoringScheduleCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" ToolTip="Save the scan schedule on this device. Scheduled scans run only while the app is open."/>
                        <TextBlock Text="{Binding MonitoringService.Status}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="POSTURE ALERTS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Send new high-impact posture changes to an HTTPS webhook. The endpoint is stored in Windows Credential Manager." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,8" TextWrapping="Wrap"/>
                        <PasswordBox x:Name="PostureWebhookUrlBox" MaxLength="2048" ToolTip="Secret-bearing HTTPS webhook URL; never written to the settings file."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save alert endpoint" Tag="PostureWebhookUrlBox" Click="SavePostureWebhookCredential_Click" Style="{StaticResource PrimaryButton}" ToolTip="Validate and store the HTTPS alert endpoint in Windows Credential Manager for this user."/>
                            <Button Content="Remove endpoint" Command="{Binding RemovePostureWebhookCredentialCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Remove the stored posture-alert endpoint. An environment-configured fallback may remain active."/>
                        </StackPanel>
                        <TextBlock Text="{Binding PostureWebhookStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="CLOUD CONNECTIONS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Use Connect Cloud in the application header to authenticate with Azure, AWS, or Google Cloud." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="TICKETING CONNECTION" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Ticketing system" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding TicketingProviders}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTicketingProviderOption, Mode=TwoWay}" ToolTip="Choose the ticketing system used for recommendation requests."/>
                        <TextBlock Text="Site URL" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TicketingSiteUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="HTTPS site URL for the selected ticketing tool. Do not include credentials, query parameters, or fragments."/>
                        <TextBlock Text="Project key / service desk ID" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TicketingProjectKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Used by Jira and Jira Service Management. Leave blank for other providers."/>
                        <TextBlock Text="Issue type / request type / category" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TicketingRequestType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Provider-specific project issue type, service request type, or incident category."/>
                        <TextBlock Text="Signed webhook URL (optional fallback)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TicketingWebhookUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="HTTPS endpoint for a signed generic ticketing webhook. Do not include credentials, query parameters, or fragments."/>
                        <TextBlock Text="API username / email" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TicketingUserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Username or email required by the selected provider's API."/>
                        <TextBlock Text="API token / secret" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="TicketingCredentialBox" MaxLength="2048" ToolTip="Saved only to Windows Credential Manager for this provider."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save URL" Command="{Binding SaveTicketingConnectionCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Validate and save the selected ticketing provider's non-secret connection settings."/>
                            <Button Content="{Binding TicketingRequestButtonText}" Command="{Binding OpenTicketingRequestCommand}" IsEnabled="{Binding CanOpenTicketingRequest}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Open the selected ticketing provider's request form."/>
                            <Button Content="Save credential" Tag="TicketingCredentialBox" Click="SaveTicketingCredentials_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Store the API credential in Windows Credential Manager for this provider."/>
                        </StackPanel>
                        <TextBlock Text="{Binding TicketingConnectionStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TicketingCredentialStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Credentials are stored in Windows Credential Manager. Native connectors are available for Jira, Jira Service Management, and ServiceNow; other providers use the signed webhook URL." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommendationsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search recommendations"/>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="EVIDENCE-BACKED PROPOSALS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Recommendations are review-only. Approved does not mean implemented." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" MaxHeight="300" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="160"/>
                                <DataGridTextColumn Header="Suggested" Binding="{Binding Suggested}" Width="220"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No recommendations are stored or generated from the latest scan." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Border Style="{StaticResource SectionCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="POLICY DRAFT WORKBENCH" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="{Binding SelectedRecommendation.Title}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="CURRENT POLICY" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecommendation.Current}" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                        <TextBlock Text="RATIONALE" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecommendation.Reason}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="PROPOSED POLICY" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecommendation.Suggested}" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                        <TextBlock Text="IMPACT ASSESSMENT" Style="{StaticResource CardLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecommendation.Impact}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="EVIDENCE" Style="{StaticResource CardLabel}" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding SelectedRecommendation.Evidence}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Export Review Draft" Command="{Binding ExportDraftCommand}" IsEnabled="{Binding CanExportDraft}" Style="{StaticResource PrimaryButton}" ToolTip="Export the selected recommendation as a non-executable JSON review draft."/>
                                    <TextBlock Text="{Binding ExportStatusMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Raise ticket" Command="{Binding RaiseTicketCommand}" IsEnabled="{Binding CanRaiseTicket}" Style="{StaticResource QuietButton}" ToolTip="Create one ticket for this selected recommendation; an existing link is reused."/>
                                    <Button Content="Refresh ticket status" Command="{Binding RefreshTicketStatusCommand}" IsEnabled="{Binding CanRefreshTicketStatus}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Fetch and save the latest status for the linked ticket."/>
                                    <TextBlock Text="{Binding TicketingStatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TicketingRequest.TicketUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TicketingRequest.TicketUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink NavigateUri="{Binding TicketingRequest.TicketUrl}" RequestNavigate="TicketLink_RequestNavigate">
                                        <Run Text="Open linked ticket: "/><Run Text="{Binding TicketingRequest.ExternalId, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding TicketingClosureMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemediationViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search recommendations and remediation plans"/>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="EVIDENCE-BACKED RECOMMENDATIONS" Style="{StaticResource CardLabel}"/>
                        <DataGrid ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" MaxHeight="220" SelectionMode="Single" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                <DataGridTextColumn Header="Current state" Binding="{Binding CurrentState}" Width="180"/>
                                <DataGridTextColumn Header="Suggested state" Binding="{Binding SuggestedState}" Width="200"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SignedInAs}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Approval or rejection rationale" Margin="4,0,8,0"/>
                            <Button Grid.Column="2" Content="Create plan" Command="{Binding CreatePlanCommand}" IsEnabled="{Binding CanCreatePlan}" Style="{StaticResource PrimaryButton}" ToolTip="Create a review-only remediation plan from the selected recommendation; no cloud changes are made."/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="REMEDIATION PLANS" Style="{StaticResource CardLabel}" Margin="0,4,0,8"/>
                        <DataGrid ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" MaxHeight="380" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation.Title}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=g}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="APPROVAL-GATED WORKFLOW" Style="{StaticResource CardLabel}" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding SelectedPlan.SafetyNotice}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PreviewFingerprint}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding ApprovalButtonText}" Command="{Binding ApprovePlanCommand}" IsEnabled="{Binding CanApprovePlan}" Style="{StaticResource PrimaryButton}" ToolTip="Approve the selected plan after reviewing its evidence and proposed changes. This does not apply cloud changes."/>
                            <Button Content="Reject" Command="{Binding RejectPlanCommand}" IsEnabled="{Binding CanRejectPlan}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Reject the selected remediation plan and record the review decision."/>
                            <Button Content="Run dry run" Command="{Binding RunDryRunCommand}" IsEnabled="{Binding CanRunDryRun}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Simulate the proposed change against stored evidence; provider policies are not changed."/>
                            <Button Content="Verify" Command="{Binding VerifyPlanCommand}" IsEnabled="{Binding CanVerifyPlan}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Check verification status. Live verification is unavailable until a provider confirms a change."/>
                            <Button Content="Prepare rollback" Command="{Binding PrepareRollbackCommand}" IsEnabled="{Binding CanPrepareRollback}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Create a separate non-executable rollback draft for review; no rollback is applied."/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SimulationSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding VerificationSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="PROPOSED CHANGES" Style="{StaticResource CardLabel}" Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedChanges}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"><Run Text="{Binding ChangeType, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Target, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding BeforeState, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding ProposedState, Mode=OneWay}"/><Run Text=" | Executable: "/><Run Text="{Binding Executable, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Rationale}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ROLLBACK DRAFT CHANGES" Style="{StaticResource CardLabel}" Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedRollbackChanges}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding Target, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding ProposedState, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="AUDIT TRAIL" Style="{StaticResource CardLabel}" Margin="0,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding SelectedAuditTrail}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=g}"/><Run Text=" | "/><Run Text="{Binding Actor, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding ActorUserId, Mode=OneWay}"/><Run Text=") | "/><Run Text="{Binding Action, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Details, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrganizationViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="ORGANIZATIONS" Style="{StaticResource CardLabel}" Margin="0,4,0,8"/>
                        <DataGrid ItemsSource="{Binding Organizations}" SelectedItem="{Binding SelectedOrganization, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" MaxHeight="220" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                <DataGridTextColumn Header="Tenant" Binding="{Binding EntraTenantId}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="MICROSOFT ENTRA SSO" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="{Binding SignedInAs}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding SignInTenantId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Entra tenant ID for the selected organization"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Sign in" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" Style="{StaticResource PrimaryButton}" ToolTip="Authenticate to the selected Microsoft Entra tenant for organization features."/>
                                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="End the current organization sign-in session."/>
                                </StackPanel>
                                <Button Content="Sync central audit events" Command="{Binding SyncCentralAuditCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" ToolTip="Upload local audit events for the selected organization to its Entra tenant's central audit log."/>
                                <TextBlock Text="{Binding CentralAuditSyncStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="CREATE ORGANIZATION" Style="{StaticResource CardLabel}"/>
                                <TextBox Text="{Binding OrganizationName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Organization name" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding TenantKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Unique organization key" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OrganizationTenantId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Microsoft Entra tenant ID; must match the signed-in tenant" Margin="0,8,0,0"/>
                                <Button Content="Create and become admin" Command="{Binding CreateOrganizationCommand}" IsEnabled="{Binding CanCreateOrganization}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" ToolTip="Create a local organization workspace and assign yourself its administrator role."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedOrganization.Name}" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentRole}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,8">
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="BOUND ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding BoundAccountCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="SCANNED ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedAccountCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedIdentities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedResources}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding ConsolidatedFindings}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CRITICAL / EFFECTIVE ACCESS" Style="{StaticResource CardLabel}"/><TextBlock Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"><Run Text="{Binding ConsolidatedCriticalFindings, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ConsolidatedEffectiveAccess, Mode=OneWay}"/></TextBlock></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding ConsolidatedCoverage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <Button Grid.Column="2" Content="Add member" Command="{Binding AddMemberCommand}" IsEnabled="{Binding CanAddMember}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Add the Entra user to the selected organization with the chosen role."/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="180" SelectionMode="Single" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding AssignedRoleName}" Width="150"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ComboBox ItemsSource="{Binding MemberRoles}" SelectedItem="{Binding SelectedMemberRoleOption, Mode=TwoWay}" DisplayMemberPath="Name" IsEnabled="{Binding CanChangeMemberRole}" MinWidth="180" ToolTip="Choose a new role for the selected organization member."/>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="CUSTOM ROLES" Style="{StaticResource CardLabel}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                    <DataGrid Grid.Column="0" ItemsSource="{Binding CustomRoles}" SelectedItem="{Binding SelectedCustomRole, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="190" SelectionMode="Single" Margin="0,0,8,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions.Count}" Width="100"/>

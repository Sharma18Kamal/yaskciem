                                        <TextBox Text="{Binding CustomRoleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Custom role name"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <CheckBox Content="View inventory" IsChecked="{Binding CustomRoleViewInventory}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow viewing scanned cloud accounts, identities, resources, and entitlements."/>
                                            <CheckBox Content="Run scans" IsChecked="{Binding CustomRoleRunScan}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow starting read-only cloud scans for bound accounts."/>
                                            <CheckBox Content="View findings" IsChecked="{Binding CustomRoleViewFindings}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow viewing risk findings and recommendations."/>
                                            <CheckBox Content="Manage members" IsChecked="{Binding CustomRoleManageMembers}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow inviting members and changing organization roles or active status."/>
                                            <CheckBox Content="Manage connections" IsChecked="{Binding CustomRoleManageConnections}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow managing organization cloud-account bindings."/>
                                            <CheckBox Content="Manage policies" IsChecked="{Binding CustomRoleManagePolicies}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow managing organization policy and exception settings."/>
                                            <CheckBox Content="Manage remediation" IsChecked="{Binding CustomRoleManageRemediations}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow creating and reviewing non-executable remediation plans."/>
                                            <CheckBox Content="Export reports" IsChecked="{Binding CustomRoleExportReports}" IsEnabled="{Binding CanManageMembers}" Margin="0,0,12,4" ToolTip="Allow exporting reports and organization evidence bundles."/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="New role" Command="{Binding NewCustomRoleCommand}" IsEnabled="{Binding CanManageMembers}" Style="{StaticResource QuietButton}" ToolTip="Start a new custom organization role definition."/>
                                            <Button Content="Save role" Command="{Binding SaveCustomRoleCommand}" IsEnabled="{Binding CanSaveCustomRole}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Save the custom role name and selected permissions."/>
                                            <Button Content="Delete role" Command="{Binding DeleteCustomRoleCommand}" IsEnabled="{Binding CanDeleteCustomRole}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Delete the selected custom role if it is not assigned to a member."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ADMIN AUDIT TRAIL" Style="{StaticResource CardLabel}"/>
                                <DataGrid ItemsSource="{Binding AuditTrail}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="180" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=g}" Width="145"/>
                                        <DataGridTextColumn Header="Actor" Binding="{Binding ActorEmail}" Width="*"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="145"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccessReviewViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding CoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="OPEN CAMPAIGNS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding OpenCampaigns}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PENDING ITEMS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding PendingItems}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ESCALATED ITEMS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding EscalatedItems}" Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="CREATE ACCESS REVIEW" Style="{StaticResource CardLabel}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" ToolTip="Campaign template" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CampaignName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Campaign name" Margin="4,0"/>
                            <TextBox Grid.Column="2" Text="{Binding CampaignDurationDays, UpdateSourceTrigger=PropertyChanged}" ToolTip="Campaign duration in days" Margin="4,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding EligibleReviewers}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding AssignedReviewerName, Mode=TwoWay}" ToolTip="Shared mode lists active organization review members; local mode lists eligible privileged cloud users." Margin="4,0"/>
                            <TextBox Grid.Column="4" Text="{Binding ActionActor, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSharedStore}" ToolTip="Shared mode records the authenticated organization identity; local mode records this actor label." Margin="8,0,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Create from Current Scan" Command="{Binding CreateCampaignCommand}" IsEnabled="{Binding CanCreateCampaign}" Style="{StaticResource PrimaryButton}" ToolTip="Create review items from the latest scan using the selected template and reviewer settings."/>
                            <Button Content="Refresh" Command="{Binding RefreshCampaignsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Reload campaigns and reevaluate reminders, deadlines, and expired exceptions."/>
                            <TextBlock Text="{Binding ReviewerEligibilityMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ReminderMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="REVIEW CAMPAIGNS" Style="{StaticResource CardLabel}" Margin="0,4,0,8"/>
                        <DataGrid ItemsSource="{Binding FilteredCampaigns}" SelectedItem="{Binding SelectedCampaign, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" MaxHeight="440" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Campaign" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueAt, StringFormat=d}" Width="95"/>
                                <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No access review campaigns." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasCampaigns}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="ACCESS REVIEW ITEMS" Style="{StaticResource CardLabel}" Margin="0,4,0,8"/>
                        <DataGrid ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" MaxHeight="300" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="80"/>
                                <DataGridTextColumn Header="Access" Binding="{Binding AccessSummary}" Width="*"/>
                                <DataGridTextColumn Header="Assigned reviewer" Binding="{Binding AssignedReviewer}" Width="130"/>
                                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerSnapshot}" Width="130"/>
                                <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="115"/>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueAt, StringFormat=d}" Width="90"/>
                                <DataGridTextColumn Header="Reminders" Binding="{Binding ReminderCount}" Width="75"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding EscalationReason}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Select a review item to see evidence and record a decision." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasReviewItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="REVIEW EVIDENCE" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="{Binding SelectedItem.EvidenceSnapshot}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                                <TextBlock Text="ATTESTATIONS" Style="{StaticResource CardLabel}" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding SelectedAttestations}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding AttestedAtUtc, Mode=OneWay, StringFormat=g}"/><Run Text=" | reviewer: "/><Run Text="{Binding Reviewer, Mode=OneWay}"/><Run Text=" | actor: "/><Run Text="{Binding Actor, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Decision, Mode=OneWay}"/><Run Text=" | SHA-256: "/><Run Text="{Binding EvidenceSha256, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding EligibleReviewers}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding AssignedReviewerName, Mode=TwoWay}" ToolTip="Shared mode lists active organization members authorized for reviews; local mode lists eligible privileged cloud users." Margin="0,0,6,0"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding ItemDueAt, Mode=TwoWay}" ToolTip="Review deadline" Margin="3,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding ActionActor, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSharedStore}" ToolTip="Shared mode records the authenticated organization identity; local mode records this actor label." Margin="3,0"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Decisions}" SelectedItem="{Binding SelectedDecision, Mode=TwoWay}" Margin="6,0,0,0" ToolTip="Choose the review decision for the selected access item."/>
                                </Grid>
                                <TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="Decision rationale; required for exception, rejection, or investigation" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <DatePicker SelectedDate="{Binding ExceptionExpiresAt, Mode=TwoWay}" ToolTip="Exception expiration date; required for exception decision"/>
                                    <Button Content="Assign reviewer" Command="{Binding AssignReviewerCommand}" IsEnabled="{Binding CanAssignReviewer}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Assign the eligible reviewer and deadline to the selected item."/>
                                    <Button Content="Record decision" Command="{Binding RecordDecisionCommand}" IsEnabled="{Binding CanRecordDecision}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Record the decision and create an evidence-hashed attestation. Non-certified decisions need a comment."/>
                                </StackPanel>
                                <TextBlock Text="AUDIT HISTORY" Style="{StaticResource CardLabel}" Margin="0,12,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedAuditTrail}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=g}"/><Run Text=" | "/><Run Text="{Binding Actor, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Action, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Details, Mode=OneWay}"/><Run Text=" | correlation: "/><Run Text="{Binding CorrelationIdText, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanHistoryViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search scan history"/>
                <DataGrid ItemsSource="{Binding Scans}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="140"/>
                        <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat=g}" Width="160"/>
                        <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat=g}" Width="160"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="Identities" Binding="{Binding Identities}" Width="90"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="80"/>
                        <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="100"/>
                        <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="80"/>
                        <DataGridTextColumn Header="Effective Access" Binding="{Binding EffectiveAccess}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No completed scans are available." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="ACCESS-CHANGE TIMELINE" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding AccessChangeCoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding AccessChanges}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" MaxHeight="360" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="85"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="85"/>
                                <DataGridTextColumn Header="Detected" Binding="{Binding DetectedAt, StringFormat=g}" Width="150"/>
                                <DataGridTextColumn Header="Provider change time" Binding="{Binding ProviderChangedAt, StringFormat=g}" Width="155"/>
                                <DataGridTextColumn Header="Changed by" Binding="{Binding ChangedBy}" Width="180"/>
                                <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="180"/>
                                <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="170"/>
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="220"/>
                                <DataGridTextColumn Header="Before" Binding="{Binding PreviousState}" Width="240"/>
                                <DataGridTextColumn Header="After" Binding="{Binding CurrentState}" Width="240"/>
                                <DataGridTextColumn Header="Evidence source" Binding="{Binding Source}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No access changes between comparable scans." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasAccessChanges}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="SCAN COVERAGE AND PERMISSIONS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding CoverageMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Coverage}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="110" MaxHeight="360" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                <DataGridTextColumn Header="Data source" Binding="{Binding DataSource}" Width="190"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Records" Binding="{Binding Records}" Width="85"/>
                                <DataGridTextColumn Header="Coverage details" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Run a live scan to see which sources were collected, empty, denied, unsupported, or unavailable." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasCoverage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="POSTURE HISTORY" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Seven-day local trend of inventory, findings, effective access, and scan-to-scan changes." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding PostureTrends}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="320" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat=g}" Width="150"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                <DataGridTextColumn Header="Accounts" Binding="{Binding Accounts}" Width="75"/>
                                <DataGridTextColumn Header="Identities" Binding="{Binding Identities}" Width="75"/>
                                <DataGridTextColumn Header="Resources" Binding="{Binding Resources}" Width="75"/>
                                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="80"/>
                                <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" Width="70"/>
                                <DataGridTextColumn Header="Critical" Binding="{Binding Critical}" Width="65"/>
                                <DataGridTextColumn Header="High" Binding="{Binding High}" Width="55"/>
                                <DataGridTextColumn Header="Access" Binding="{Binding EffectiveAccess}" Width="65"/>
                                <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="55"/>
                                <DataGridTextColumn Header="Removed" Binding="{Binding Removed}" Width="65"/>
                                <DataGridTextColumn Header="Changed" Binding="{Binding Changed}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="DRIFT ALERTS AND NOTIFICATION DELIVERY" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding NotificationDeliveryMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding DriftAlerts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="320" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Detected" Binding="{Binding DetectedAt, StringFormat=g}" Width="150"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="90"/>
                                <DataGridTextColumn Header="Change" Binding="{Binding Type}" Width="85"/>
                                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="130"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Alert" Binding="{Binding AlertEligible}" Width="60"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No posture changes are recorded in the retained history." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDriftAlerts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <Border Style="{StaticResource EmptyStateCard}"><StackPanel><TextBlock Text="○" Foreground="{StaticResource AccentBrush}" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="{Binding DemoRecords}" Foreground="{StaticResource PrimaryBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="{Binding DemoStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Demo Mode data uses the normalized CIEM model and SQLite persistence." Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}" />
</UserControl>

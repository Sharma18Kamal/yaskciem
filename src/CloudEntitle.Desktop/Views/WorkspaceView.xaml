                                    <Button Grid.Column="2" Content="Add member" Command="{Binding AddMemberCommand}" IsEnabled="{Binding CanAddMember}" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="180" SelectionMode="Single" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding AssignedRoleName}" Width="150"/>

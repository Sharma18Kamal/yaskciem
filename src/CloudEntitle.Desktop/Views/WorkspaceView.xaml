                                    <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshScanOperationsCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Refresh server-side scan schedules and job outcomes"/>

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableAccounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" DisplayMemberPath="AccountName" ToolTip="Accounts from the latest live scan"/>
                                    <Button Grid.Column="1" Content="Bind account" Command="{Binding BindAccountCommand}" IsEnabled="{Binding CanBindAccount}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Associate the selected scanned cloud account with this organization."/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding Bindings}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="180" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                        <DataGridTextColumn Header="External account" Binding="{Binding ExternalTenantId}" Width="190"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ORGANIZATION MEMBERS" Style="{StaticResource CardLabel}"/>

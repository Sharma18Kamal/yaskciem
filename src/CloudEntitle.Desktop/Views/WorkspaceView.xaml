<UserControl x:Class="CloudEntitle.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Scan Now" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Scan signed-in cloud providers using read-only CLI access"/>
                <TextBlock Text="{Binding ScanStatusMessage}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="2" Rows="4">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CLOUD ACCOUNTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CloudAccounts}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Identities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RESOURCES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Resources}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ENTITLEMENTS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding Entitlements}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PRIVILEGED IDENTITIES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding PrivilegedIdentities}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="RISK FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding RiskFindings}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CRITICAL FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CriticalFindings}" Foreground="{StaticResource CriticalBrush}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LAST SCAN" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding LastScan}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY PROVIDER" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsByProvider}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="RISK BY SEVERITY" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding FindingsBySeverity}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="ACCESS DECISIONS" Style="{StaticResource CardLabel}"/><ItemsControl ItemsSource="{Binding AccessByDecision}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
            <StackPanel><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search resources"/><ContentControl Content="{Binding}"/></StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudAccountsViewModel}">
            <StackPanel>
                <TextBlock Text="CONNECT A CLOUD PROVIDER" Style="{StaticResource CardLabel}"/>
                <TextBlock Text="Sign-in opens in the provider's CLI. Use organization-approved identities with read-only permissions; credentials stay with the CLI and are never entered into YASK-CIEM. Disconnect signs out of the shared CLI session and may affect other tools." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryBrush}" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CliName}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MinHeight="38" Margin="0,10,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Run the provider's interactive sign-in command"/>
                                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Sign out of this provider's shared CLI session"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ConnectionGuidance}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel><Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="APPLICATION" Style="{StaticResource CardLabel}"/><TextBlock Text="Version" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBlock Text="0.1.0" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/><TextBlock Text="Data location" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBlock Text="{Binding DataLocation}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="DEMO MODE" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding DemoModeState}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Synthetic Azure, AWS, and GCP data is stored through the normal SQLite pipeline. No cloud APIs or credentials are used." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="Load Demo Data" Command="{Binding LoadDemoDataCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Reset Demo Data" Command="{Binding ResetDemoDataCommand}" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border><Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Text="CLOUD CONNECTIONS" Style="{StaticResource CardLabel}"/><TextBlock Text="Use Connect Cloud in the application header to authenticate with Azure, AWS, or Google Cloud." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommendationsViewModel}">
            <StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" ToolTip="Search recommendations"/>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="EVIDENCE-BACKED PROPOSALS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="Recommendations are review-only. Approved does not mean implemented." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Recommendations}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding RecommendationType}" Width="180"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100"/>
                                <DataGridTextColumn Header="State" Binding="{Binding EvaluationState}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentState}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <Border Style="{StaticResource EmptyStateCard}"><StackPanel><TextBlock Text="○" Foreground="{StaticResource AccentBrush}" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="{Binding DemoRecords}" Foreground="{StaticResource PrimaryBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="{Binding DemoStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Demo Mode data uses the normalized CIEM model and SQLite persistence." Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}" />
</UserControl>

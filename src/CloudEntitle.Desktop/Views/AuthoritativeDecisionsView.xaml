<UserControl x:Class="CloudEntitle.Desktop.Views.AuthoritativeDecisionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14" Margin="0,10,0,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Authoritative IAM decision transitions" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="ConfirmedDecisionEscalation is narrowly NOT_GRANTED → GRANTED for an exact native IAM tuple and captured context. It is NOT proof of operational access, abuse or all-action escalation. Azure/AWS simulations and partial policies remain unsupported or Potential." />
            <TextBlock Margin="0,0,0,8" Text="{Binding SetupInstructions}" TextWrapping="Wrap" />
            <WrapPanel>
                <Button Content="Load configured connections" Command="{Binding LoadSourcesCommand}" Padding="10,4" Margin="0,0,8,8" />
                <ComboBox Width="300" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          DisplayMemberPath="SourceId" Margin="0,0,8,8" />
                <ComboBox Width="300" ItemsSource="{Binding Principals}" SelectedItem="{Binding Principal}" Margin="0,0,8,8" />
                <ComboBox Width="300" ItemsSource="{Binding Permissions}" SelectedItem="{Binding Permission}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding FullResourceName}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <CheckBox Content="I authorize one read-only native IAM evaluation" IsChecked="{Binding ReadConsent}" Margin="0,4,12,8" />
                <Button Content="Capture and save" Command="{Binding CaptureCommand}" Padding="10,4" Margin="0,0,8,8" />
                <Button Content="Refresh saved history" Command="{Binding LoadHistoryCommand}" Padding="10,4" Margin="0,0,8,8" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,4" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" MaxHeight="230">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Captured (UTC)" Binding="{Binding CompletedAtUtc}" Width="170" />
                    <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="200" />
                    <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="220" />
                    <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="120" />
                    <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="140" />
                    <DataGridTextColumn Header="Snapshot ID" Binding="{Binding SnapshotId}" Width="250" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,10,0,8">
                <TextBlock Text="Before" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="330" ItemsSource="{Binding History}" SelectedItem="{Binding Before}" DisplayMemberPath="SnapshotId" Margin="0,0,8,0" />
                <TextBlock Text="After" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="330" ItemsSource="{Binding History}" SelectedItem="{Binding After}" DisplayMemberPath="SnapshotId" Margin="0,0,8,0" />
                <Button Content="Analyze saved decisions" Command="{Binding AnalyzeCommand}" Padding="10,4" />
            </WrapPanel>
            <TextBlock Text="{Binding Report.Status}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Report.Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Report.Blockers}" />
        </StackPanel>
    </Border>
</UserControl>

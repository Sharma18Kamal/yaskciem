<UserControl x:Class="CloudEntitle.Desktop.Views.TrustCredentialMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14" Margin="0,10,0,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Trust and credential monitoring" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="On-demand Azure Entra, AWS IAM, or GCP service-account trust and credential metadata collection. No secrets, private keys, tokens, or cloud writes are collected or performed. Coverage is partial." />
            <WrapPanel VerticalAlignment="Center">
                <ComboBox Width="320" Margin="0,0,8,8" ItemsSource="{Binding TrustCredentialBindings}"
                          SelectedItem="{Binding SelectedTrustCredentialBinding}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{Binding TrustCredentialSetupInstructions}" />
                <CheckBox Margin="0,4,10,8" IsChecked="{Binding TrustCredentialReadConsent}"
                          Content="{Binding TrustCredentialConsentLabel}"
                          ToolTip="No source is contacted until collection is explicitly started." />
                <Button Margin="0,0,8,8" Padding="10,4" Content="Collect and save"
                        Command="{Binding CollectTrustCredentialCommand}"
                        ToolTip="{Binding TrustCredentialSetupInstructions}" />
                <Button Margin="0,0,8,8" Padding="10,4" Content="Refresh history"
                        Command="{Binding LoadTrustCredentialHistoryCommand}"
                        ToolTip="Reads saved immutable snapshots only; does not contact Azure." />
            </WrapPanel>
            <TextBlock Margin="0,0,0,8" Text="{Binding TrustCredentialMonitoringStatus}" TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,8" Text="{Binding TrustCredentialCoverageDetails}" TextWrapping="Wrap" />
            <WrapPanel>
                <ComboBox Width="360" Margin="0,0,8,8" ItemsSource="{Binding TrustCredentialHistory}"
                          SelectedItem="{Binding SelectedTrustCredentialSnapshot}"
                          DisplayMemberPath="CollectedAtUtc"
                          ToolTip="Select one saved observation to inspect." />
                <Button Margin="0,0,8,8" Padding="10,4" Content="Load selected snapshot"
                        Command="{Binding LoadTrustCredentialSnapshotCommand}"
                        ToolTip="Loads one saved immutable snapshot without a live call." />
                <Button Margin="0,0,8,8" Padding="10,4" Content="Compare effective-access scans"
                        Command="{Binding RefreshPrivilegeScanOptionsCommand}"
                        ToolTip="Loads saved scan summaries for this account; potential analysis requires choosing an ordered pair." />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <ComboBox Width="320" Margin="0,0,8,8" ItemsSource="{Binding PrivilegeScanBindings}"
                          SelectedItem="{Binding SelectedPrivilegeScanBinding}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="Select the Azure, AWS or GCP bound account for saved effective-access comparison." />
                <ComboBox Width="360" Margin="0,0,8,8" ItemsSource="{Binding PrivilegeScanOptions}"
                          SelectedItem="{Binding SelectedPrivilegeBaselineScan}"
                          DisplayMemberPath="CompletedAtUtc"
                          ToolTip="Choose the earlier saved scan as a comparison baseline." />
                <ComboBox Width="360" Margin="0,0,8,8" ItemsSource="{Binding PrivilegeScanOptions}"
                          SelectedItem="{Binding SelectedPrivilegeCurrentScan}"
                          DisplayMemberPath="CompletedAtUtc"
                          ToolTip="Choose the later saved scan to compare against the baseline." />
                <Button Margin="0,0,8,8" Padding="10,4" Content="Analyze selected scans"
                        Command="{Binding AnalyzePrivilegeScansCommand}"
                        ToolTip="Role/assignment observations only produce Potential signals unless authoritative comparable effective decisions exist." />
            </WrapPanel>
            <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Saved credential and trust metadata" />
            <DataGrid ItemsSource="{Binding TrustCredentialObservations}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Principal" Binding="{Binding PrincipalName}" Width="150" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="150" />
                    <DataGridTextColumn Header="Evidence ID" Binding="{Binding EvidenceId}" Width="180" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                    <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="180" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180" />
                    <DataGridTextColumn Header="Valid until (UTC)" Binding="{Binding ValidUntilUtc}" Width="170" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Observed trust / credential changes" />
            <DataGrid ItemsSource="{Binding TrustCredentialChanges}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Principal" Binding="{Binding PrincipalName}" Width="160" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140" />
                    <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="180" />
                    <DataGridTextColumn Header="Evidence ID" Binding="{Binding EvidenceId}" Width="180" />
                    <DataGridTextColumn Header="Evidence boundary" Binding="{Binding Evidence}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Potential effective privilege changes" />
            <DataGrid ItemsSource="{Binding PrivilegeEscalationSignals}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="110" />
                    <DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="180" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="180" />
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="220" />
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>

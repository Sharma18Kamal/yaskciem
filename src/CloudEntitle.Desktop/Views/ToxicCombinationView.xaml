<UserControl x:Class="CloudEntitle.Desktop.Views.ToxicCombinationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Refresh saved findings" Command="{Binding ReloadCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
                <Button Content="Load Demo Mode" Command="{Binding LoadDemoCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="250" Margin="0,0,8,8"
                         Style="{StaticResource SearchBox}" ToolTip="Search findings by rule, provider, identity, resource or evidence."/>
            </WrapPanel>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Findings represent risky capability combinations, not confirmed exploitation. Conditions, inherited scopes, external trust and provider-side controls require review. No permissions are changed."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <WrapPanel>
                <Border Style="{StaticResource MetricCard}" MinWidth="170"><StackPanel><TextBlock Text="SAVED FINDINGS" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding OpenFindingCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" MinWidth="150"><StackPanel><TextBlock Text="CRITICAL" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding CriticalFindingCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" MinWidth="150"><StackPanel><TextBlock Text="HIGH" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding HighFindingCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}" MinWidth="150"><StackPanel><TextBlock Text="ENABLED RULES" Style="{StaticResource CardLabel}"/><TextBlock Text="{Binding EnabledRuleCount}" Style="{StaticResource CardValue}"/></StackPanel></Border>
            </WrapPanel>

            <TabControl MinHeight="390">
                <TabItem Header="Toxic combination dashboard">
                    <DataGrid ItemsSource="{Binding FilteredFindings}" SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" SortMemberPath="Provider"/>
                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" SortMemberPath="Identity" MinWidth="150"/>
                            <DataGridTextColumn Header="Combination" Binding="{Binding RuleName}" SortMemberPath="RuleName" MinWidth="220"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="Severity"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore}" SortMemberPath="RiskScore"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" SortMemberPath="Confidence"/>
                            <DataGridTextColumn Header="Scope relation" Binding="{Binding ResourceRelation}" SortMemberPath="ResourceRelation"/>
                            <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" SortMemberPath="Resource" MinWidth="150"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" MinWidth="280"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Identity risk analysis">
                    <DataGrid ItemsSource="{Binding FilteredFindings}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" SortMemberPath="Identity" MinWidth="180"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" SortMemberPath="Provider"/>
                            <DataGridTextColumn Header="Combination" Binding="{Binding RuleName}" SortMemberPath="RuleName" MinWidth="220"/>
                            <DataGridTextColumn Header="Evaluation" Binding="{Binding EvaluationState}" SortMemberPath="EvaluationState"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="Severity"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" SortMemberPath="Confidence"/>
                            <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Dangerous permission combinations">
                    <DataGrid ItemsSource="{Binding FilteredEvidence}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" SortMemberPath="Provider"/>
                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" MinWidth="180"/>
                            <DataGridTextColumn Header="Permission action" Binding="{Binding Action}" SortMemberPath="Action" MinWidth="240"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" SortMemberPath="Scope" MinWidth="220"/>
                            <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentType}" SortMemberPath="AssignmentType"/>
                            <DataGridCheckBoxColumn Header="Direct" Binding="{Binding IsDirect}"/>
                            <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding IsInherited}"/>
                            <DataGridCheckBoxColumn Header="Conditional" Binding="{Binding IsConditional}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Finding evidence">
                    <DataGrid ItemsSource="{Binding FilteredEvidence}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" MinWidth="230"/>
                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" MinWidth="170"/>
                            <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" MinWidth="150"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceEvidence}" MinWidth="400"/>
                            <DataGridTextColumn Header="Evaluation" Binding="{Binding EvaluationStatus}" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Cross-account trust paths">
                    <DataGrid ItemsSource="{Binding TrustPathEvidence}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Step" Binding="{Binding Sequence}" SortMemberPath="Sequence"/>
                            <DataGridTextColumn Header="Source provider" Binding="{Binding SourceProvider}" SortMemberPath="SourceProvider"/>
                            <DataGridTextColumn Header="Source identity" Binding="{Binding SourceIdentity}" MinWidth="180"/>
                            <DataGridTextColumn Header="Source account" Binding="{Binding SourceAccountId}" MinWidth="190"/>
                            <DataGridTextColumn Header="Target provider" Binding="{Binding TargetProvider}" SortMemberPath="TargetProvider"/>
                            <DataGridTextColumn Header="Target identity" Binding="{Binding TargetIdentity}" MinWidth="180"/>
                            <DataGridTextColumn Header="Target account" Binding="{Binding TargetAccountId}" MinWidth="190"/>
                            <DataGridTextColumn Header="Relationship" Binding="{Binding RelationshipType}" MinWidth="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Evidence source" Binding="{Binding EvidenceSource}" MinWidth="180"/>
                            <DataGridTextColumn Header="Evidence reference" Binding="{Binding EvidenceReference}" MinWidth="260"/>
                            <DataGridCheckBoxColumn Header="Source permission required" Binding="{Binding RequiresSourcePermission}"/>
                            <DataGridTextColumn Header="Required source action" Binding="{Binding RequiredSourcePermissionPattern}" MinWidth="200"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding ConditionEvidence}" MinWidth="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Remediation recommendations">
                    <DataGrid ItemsSource="{Binding Recommendations}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserSortColumns="True" AlternationCount="2" MinHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleKey}" SortMemberPath="RuleKey"/>
                            <DataGridTextColumn Header="Recommendation" Binding="{Binding Title}" SortMemberPath="Title" MinWidth="230"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status"/>
                            <DataGridCheckBoxColumn Header="Executable" Binding="{Binding Executable}"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Description}" MinWidth="360"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Rule management">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                            <Button Content="Save rule configuration" Command="{Binding SaveRulesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <TextBlock Text="Use | to separate alternate action patterns. Permission patterns support * and ?; provider semantics remain distinct."
                                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="Create a custom rule" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <TextBox Text="{Binding NewRuleKey, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" Margin="0,0,8,8" ToolTip="Unique lowercase key; letters, digits, dot, dash and underscore."/>
                                    <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" MinWidth="240" Margin="0,0,8,8" ToolTip="Rule name."/>
                                    <ComboBox ItemsSource="{Binding RuleProviders}" SelectedItem="{Binding NewRuleProvider}"
                                              DisplayMemberPath="DisplayName" MinWidth="180" Margin="0,0,8,8"/>
                                    <ComboBox ItemsSource="{Binding ResourceRequirements}" SelectedItem="{Binding NewRuleResourceRequirement}" MinWidth="180" Margin="0,0,8,8"/>
                                    <ComboBox ItemsSource="{Binding RuleSeverities}" SelectedItem="{Binding NewRuleSeverity}" MinWidth="120" Margin="0,0,8,8"/>
                                    <TextBox Text="{Binding NewRuleRiskScore, UpdateSourceTrigger=PropertyChanged}" MinWidth="90" Margin="0,0,8,8" ToolTip="Risk score 0-100."/>
                                </WrapPanel>
                                <TextBox Text="{Binding NewRuleDescription, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Margin="0,0,0,8"
                                         AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Explain the risk capability represented by the permission pair."/>
                                <WrapPanel>
                                    <TextBox Text="{Binding NewRuleFirstPattern, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" Margin="0,0,8,8" ToolTip="First action pattern; use | for alternatives."/>
                                    <TextBox Text="{Binding NewRuleSecondPattern, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" Margin="0,0,8,8" ToolTip="Second action pattern; use | for alternatives."/>
                                </WrapPanel>
                                <TextBox Text="{Binding NewRuleRecommendation, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Margin="0,0,0,8"
                                         AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Review-only recommendation; rules never apply permissions."/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Require same resource" IsChecked="{Binding NewRuleRequireSameResource}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Require evidenced trust path" IsChecked="{Binding NewRuleRequireTrustPath}" Margin="0,0,16,0"/>
                                    <CheckBox Content="First permission is privileged" IsChecked="{Binding NewRuleFirstRequiresPrivileged}" Margin="0,0,16,0"/>
                                    <CheckBox Content="Second permission is privileged" IsChecked="{Binding NewRuleSecondRequiresPrivileged}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Preview against local inventory" Command="{Binding PreviewNewRuleCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
                                    <Button Content="Save previewed rule" Command="{Binding AddNewRuleCommand}" Style="{StaticResource PrimaryButton}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding RuleEditorStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding PreviewFindings}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserSortColumns="True" AlternationCount="2" MinHeight="90" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}"/>
                                        <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" MinWidth="150"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" MinWidth="300"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Configured rules" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/>
                                <DataGrid ItemsSource="{Binding Rules}" IsReadOnly="False" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" AlternationCount="2" MinHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" MinWidth="85"/>
                                        <DataGridTextColumn Header="Rule name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" MinWidth="220"/>
                                        <DataGridTextColumn Header="First permission pattern" Binding="{Binding FirstPermissionPattern, UpdateSourceTrigger=LostFocus}" MinWidth="260"/>
                                        <DataGridTextColumn Header="Second permission pattern" Binding="{Binding SecondPermissionPattern, UpdateSourceTrigger=LostFocus}" MinWidth="260"/>
                                        <DataGridTextColumn Header="Resource requirement" Binding="{Binding ResourceRequirement}" MinWidth="150"/>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" MinWidth="90"/>
                                        <DataGridTextColumn Header="Risk score" Binding="{Binding RiskScore}" MinWidth="85"/>
                                        <DataGridCheckBoxColumn Header="Same resource" Binding="{Binding RequireSameResource}"/>
                                        <DataGridCheckBoxColumn Header="Trust path" Binding="{Binding RequireTrustPath}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Rule change audit history" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/>
                                <DataGrid ItemsSource="{Binding RuleAuditHistory}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserSortColumns="True" AlternationCount="2" MinHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Timestamp}" SortMemberPath="Timestamp"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}"/>
                                        <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" MinWidth="180"/>
                                        <DataGridTextColumn Header="Rule key" Binding="{Binding RuleKey}"/>
                                        <DataGridTextColumn Header="Before / after" Binding="{Binding Details}" MinWidth="420"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

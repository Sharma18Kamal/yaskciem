<UserControl x:Class="CloudEntitle.Desktop.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="ScanProgress_IsVisibleChanged" Loaded="ScanProgress_Loaded" Unloaded="ScanProgress_Unloaded"
             HorizontalAlignment="Right" MaxWidth="360">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Canvas x:Name="ScanHourglass" Width="26" Height="34" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Rotating hourglass with flowing sand">
                    <Canvas.RenderTransform><RotateTransform/></Canvas.RenderTransform>
                    <Canvas.Resources>
                        <Storyboard x:Key="HourglassCycle" RepeatBehavior="Forever" Duration="0:0:6">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanHourglass" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="180"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:5" Value="180"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="360"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpperSand" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LowerSand" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SandStream" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Canvas.Resources>
                    <Path Data="M 4,4 L 22,4 C 22,12 16,14 13,17 C 16,20 22,22 22,30 L 4,30 C 4,22 10,20 13,17 C 10,14 4,12 4,4 Z" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                    <Path x:Name="UpperSand" Data="M 6,7 L 20,7 L 13,16 Z" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                        <Path.RenderTransform><ScaleTransform ScaleY="1"/></Path.RenderTransform>
                    </Path>
                    <Path x:Name="LowerSand" Data="M 6,28 L 20,28 L 13,20 Z" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                        <Path.RenderTransform><ScaleTransform ScaleY="0"/></Path.RenderTransform>
                    </Path>
                    <Path x:Name="SandStream" Data="M 13,15 L 13,26" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0"/>
                    <Path Data="M 2,3 L 24,3 M 2,31 L 24,31" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Cloud scan in progress" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ScanStatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ScanElapsedText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <ProgressBar Height="4" IsIndeterminate="True" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" ToolTip="Scan in progress"/>
        </StackPanel>
    </Border>
</UserControl>

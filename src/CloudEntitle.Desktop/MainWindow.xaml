<Window x:Class="CloudEntitle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels"
        Title="YASK-CIEM" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,0" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YASK-CIEM" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Cloud identity exposure management" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}"><TextBlock Text="READ-ONLY" Foreground="{StaticResource SuccessBrush}"/></Border>
                    <Button Content="Connect Cloud" Command="{Binding NavigateCommand}" CommandParameter="{Binding CloudAccountsNavigationItem}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" ToolTip="Connect Azure, AWS, or GCP using its official CLI"/>
                    <Button Content="Disconnect Cloud" Command="{Binding OpenCloudDisconnectCommand}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Open provider sign-out controls"/>
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsNavigationItem}" Style="{StaticResource QuietButton}" Margin="12,0,0,0" ToolTip="Open application settings"/>
                    <Button Content="−" Style="{StaticResource WindowChromeButton}" Margin="16,0,0,0" Click="MinimizeButton_Click" ToolTip="Minimize window" AutomationProperties.Name="Minimize window"/>
                    <Button Content="□" Style="{StaticResource WindowChromeButton}" Click="MaximizeButton_Click" ToolTip="Maximize or restore window" AutomationProperties.Name="Maximize or restore window"/>
                    <Button Content="×" Style="{StaticResource WindowChromeButton}" Click="CloseButton_Click" ToolTip="Close YASK-CIEM" AutomationProperties.Name="Close YASK-CIEM"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="SECURITY WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="No cloud connections" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="Connect read-only sources when ready." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource NavigationButton}" ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Style="{StaticResource NavIcon}"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="34,30">
                <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding CurrentNavigationItem.Title}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentViewModel.Title}" Foreground="{StaticResource PrimaryBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding CurrentViewModel.Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,24"/>
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                <TextBlock Text="  |  Database: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding DatabaseStatus}" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                <TextBlock Text="  |  Cloud: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding CloudConnectionStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="  |  v" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding ApplicationVersion}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CloudEntitle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudEntitle.Desktop"
        mc:Ignorable="d"
        Title="YASK-CIEM" Height="820" Width="1400" MinHeight="680" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="#08111F" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101C2E" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#14243A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#20334D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8292A8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F8FC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#35C6B0" />
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1B3047" />
                                <Setter Property="Foreground" Value="#F4F8FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#24415D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F3854" />
            <Setter Property="Foreground" Value="#EAF4F5" />
            <Setter Property="BorderBrush" Value="#2E506B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#2A4A68" />
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#35C6B0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#173047" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0C1727" />
            <Setter Property="Foreground" Value="#D9E4EF" />
            <Setter Property="BorderBrush" Value="#20334D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="#0C1727" />
            <Setter Property="AlternatingRowBackground" Value="#101E31" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1B2C42" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#162A42" />
            <Setter Property="Foreground" Value="#8FA6BC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" Width="238" Background="#0B1728" BorderBrush="#1D3048" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="YASK" FontSize="26" FontWeight="Bold" Foreground="#F4F8FC" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="CIEM" FontSize="26" FontWeight="Bold" Foreground="#35C6B0" />
                        <Border Background="#173B4B" CornerRadius="4" Padding="7,3" Margin="10,2,0,0">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="#7DE0D0" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Cloud identity exposure management" Foreground="#72879F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,26" />
                    <TextBlock Text="WORKSPACE" Foreground="#58708A" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,8" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                <Button Content="Dashboard" Tag="dashboard" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}" Foreground="#E2E8F0"/>
                <Button Content="Cloud Accounts" Tag="accounts" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Identities" Tag="identities" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Permissions" Tag="permissions" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Risk Findings" Tag="findings" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Recommendations" Tag="recommendations" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Reports" Tag="reports" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                <Button Content="Settings" Tag="settings" Click="NavigationButton_Click" Style="{StaticResource NavigationButton}"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#10243A" BorderBrush="#1D3A51" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="READ-ONLY MODE" Foreground="#6FD9C8" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Discover and assess access without changing cloud resources." Foreground="#8195AA" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="30,26,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,20" Margin="0,0,0,22" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#35C6B0" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE SECURITY POSTURE" Foreground="#6FD9C8" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Cloud entitlement visibility" Foreground="#F4F8FC" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Review identities, permissions, and exposure across connected providers." Foreground="#8292A8" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderFilters}" SelectedItem="{Binding SelectedProviderFilter, UpdateSourceTrigger=PropertyChanged}" Width="145" Height="38" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Filter the dashboard by cloud provider"/>
                    <Button Grid.Column="2" Content="Scan now" Command="{Binding ScanCommand}" Width="112" Height="38" Style="{StaticResource ActionButton}" Background="#167D78" BorderBrush="#35C6B0"/>
                    <Button Grid.Column="3" Content="Export JSON" Command="{Binding ExportReportCommand}" Width="112" Height="38" Margin="10,0,0,0" Style="{StaticResource ActionButton}"/>
                    <Button Grid.Column="4" Content="Export CSV" Command="{Binding ExportCsvCommand}" Width="112" Height="38" Margin="10,0,0,0" Style="{StaticResource ActionButton}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,14,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CLOUD ACCOUNTS" Foreground="#8292A8" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalCloudAccounts}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Connected inventory" Foreground="#60758C" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,14,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="HIGH RISK FINDINGS" Foreground="#8292A8" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HighRiskFindings}" Foreground="#FF9B8F" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock Text="Requires attention" Foreground="#8C6F73" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="0,0,14,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PRIVILEGED IDENTITIES" Foreground="#8292A8" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PrivilegedIdentities}" Foreground="#F5C86A" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock Text="Review standing access" Foreground="#8F805F" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PanelStyle}" Margin="0,0,0,14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CRITICAL FINDINGS" Foreground="#8292A8" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CriticalFindings}" Foreground="#FF6E78" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock Text="Immediate review" Foreground="#98666D" FontSize="10" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource PanelStyle}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="INVENTORY &amp; FINDINGS" Foreground="#E3EDF6" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#8292A8" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" />
                        </Grid>
                        <TabControl x:Name="InventoryTabs" Margin="0,18,0,0" Background="#0C1727">
                            <TabItem Header="Risk Findings">
                                <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110"/>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding CloudProvider}" Width="110"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="220"/>
                                        <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="180"/>
                                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Identities">
                                <DataGrid ItemsSource="{Binding Principals}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding CloudProvider}" Width="110"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding IdentityType}" Width="150"/>
                                        <DataGridCheckBoxColumn Header="Privileged" Binding="{Binding IsPrivileged}" Width="100"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Roles">
                                <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                        <DataGridTextColumn Header="Role ID" Binding="{Binding RoleId}" Width="220"/>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Permissions">
                                <DataGrid ItemsSource="{Binding Permissions}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180"/>
                                        <DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="*"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="CloudEntitle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CloudEntitle.Desktop.ViewModels"
        Title="YASK-CIEM" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,12" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F79BF" Offset="0"/>
                                <GradientStop Color="#193B5D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect><DropShadowEffect Color="#2F79BF" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
                        <TextBlock Text="Y" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="YASK-CIEM" FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI" FontSize="26" FontWeight="ExtraBold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#193B5D" Offset="0"/>
                                    <GradientStop Color="#2F79BF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="CLOUD IDENTITY EXPOSURE MANAGEMENT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Developed By: Sharma Kamal K" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" MaxWidth="280"/>
                </Grid>
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="250" Margin="20,0,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="SECURITY WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CloudConnectionStatus}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Connect multiple cloud providers. Scans are read-only and do not modify cloud resources." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
                    <Border Style="{StaticResource StatusPill}" ToolTip="Fourteen-day local trial status. The trial continues across app reinstalls on this Windows installation."><TextBlock Text="{Binding TrialStatusText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/></Border>
                    <Button Content="Connect Cloud" Command="{Binding NavigateCommand}" CommandParameter="{Binding CloudAccountsNavigationItem}" IsEnabled="{Binding IsTrialActive}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" ToolTip="Connect Azure, AWS, or GCP using its official CLI"/>
                    <Button Content="{Binding DisconnectCloudButtonLabel}" Command="{Binding OpenCloudDisconnectCommand}" IsEnabled="{Binding CanDisconnectCloud}" Style="{StaticResource QuietButton}" Margin="8,0,0,0" ToolTip="Disconnect the active CLI or cancel a pending sign-in"/>
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsNavigationItem}" IsEnabled="{Binding IsTrialActive}" Style="{StaticResource QuietButton}" Margin="12,0,0,0" ToolTip="Open application settings"/>
                    <Button Content="−" Style="{StaticResource WindowChromeButton}" Margin="16,0,0,0" Click="MinimizeButton_Click" ToolTip="Minimize window" AutomationProperties.Name="Minimize window"/>
                    <Button Content="□" Style="{StaticResource WindowChromeButton}" Click="MaximizeButton_Click" ToolTip="Maximize or restore window" AutomationProperties.Name="Maximize or restore window"/>
                    <Button Content="×" Style="{StaticResource WindowChromeButton}" Click="CloseButton_Click" ToolTip="Close YASK-CIEM" AutomationProperties.Name="Close YASK-CIEM"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" IsEnabled="{Binding IsTrialActive}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22">
                <DockPanel>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource NavigationButton}" ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Style="{StaticResource NavIcon}"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="34,30">
                <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentNavigationItem.Title}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentViewModel.Title}" Foreground="{StaticResource PrimaryBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentViewModel.Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                <TextBlock Text="  |  Database: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding DatabaseStatus}" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                <TextBlock Text="  |  Cloud: " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding CloudConnectionStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="  |  v" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding ApplicationVersion}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

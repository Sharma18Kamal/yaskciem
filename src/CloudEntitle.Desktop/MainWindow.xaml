<Window x:Class="CloudEntitle.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudEntitle.Desktop"
        mc:Ignorable="d"
        Title="YASK-CIEM" Height="760" Width="1280" WindowStartupLocation="CenterScreen" Background="#0F172A">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <StackPanel Margin="20,24,20,20">
                <TextBlock Text="YASK-CIEM" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,24"/>
                <TextBlock Text="Dashboard" Foreground="#E2E8F0" Margin="0,8"/>
                <TextBlock Text="Cloud Accounts" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Identities" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Permissions" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Risk Findings" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Recommendations" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Reports" Foreground="#CBD5E1" Margin="0,8"/>
                <TextBlock Text="Settings" Foreground="#CBD5E1" Margin="0,8"/>
            </StackPanel>
        </Border>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20" Margin="0,0,0,20" Background="#111827" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cloud entitlement visibility" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text="Security overview" Foreground="#F8FAFC" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Scan Now" Width="120" Height="36" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Background="#0B1220" CornerRadius="12" Margin="0,0,12,12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Total Cloud Accounts" Foreground="#94A3B8"/>
                        <TextBlock Text="0" Foreground="#F8FAFC" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0B1220" CornerRadius="12" Margin="0,0,12,12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="High Risk Findings" Foreground="#94A3B8"/>
                        <TextBlock Text="0" Foreground="#F87171" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0B1220" CornerRadius="12" Margin="0,0,12,12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Privileged Identities" Foreground="#94A3B8"/>
                        <TextBlock Text="0" Foreground="#FBBF24" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#0B1220" CornerRadius="12" Margin="0,0,0,12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Critical Findings" Foreground="#94A3B8"/>
                        <TextBlock Text="0" Foreground="#F87171" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#111827" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Provider overview" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Dashboard and risk overview will be populated by the scan engine and normalized cloud findings." Foreground="#CBD5E1" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

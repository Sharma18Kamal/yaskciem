<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CloudEntitle.LicenseServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
    <!-- Keep Identity.Web's cryptography dependency patched for downstream test consumers. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.25.1" />
    <ProjectReference Include="..\CloudEntitle.Licensing\CloudEntitle.Licensing.csproj" />
    <ProjectReference Include="..\CloudEntitle.Integration\CloudEntitle.Integration.csproj" />
    <ProjectReference Include="..\CloudEntitle.Security\CloudEntitle.Security.csproj" />
    <ProjectReference Include="..\CloudEntitle.OrganizationManagement\CloudEntitle.OrganizationManagement.csproj" />
    <ProjectReference Include="..\CloudEntitle.IdentityGovernance\CloudEntitle.IdentityGovernance.csproj" />
    <ProjectReference Include="..\CloudEntitle.Infrastructure\CloudEntitle.Infrastructure.csproj" />
    <ProjectReference Include="..\CloudEntitle.Cloud.Azure\CloudEntitle.Cloud.Azure.csproj" />
    <ProjectReference Include="..\CloudEntitle.Cloud.Aws\CloudEntitle.Cloud.Aws.csproj" />
    <ProjectReference Include="..\CloudEntitle.Cloud.Gcp\CloudEntitle.Cloud.Gcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\infra\postgres\002-central-monitoring.sql" LogicalName="CloudEntitle.LicenseServer.MonitoringSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\003-governance-deadlines.sql" LogicalName="CloudEntitle.LicenseServer.GovernanceSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\004-operational-integrations.sql" LogicalName="CloudEntitle.LicenseServer.OperationsSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\005-operations-scale.sql" LogicalName="CloudEntitle.LicenseServer.ScaleSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\006-security-connectors.sql" LogicalName="CloudEntitle.LicenseServer.SecurityConnectorSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\007-cloud-activity.sql" LogicalName="CloudEntitle.LicenseServer.CloudActivitySchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\008-inbound-security.sql" LogicalName="CloudEntitle.LicenseServer.InboundSecuritySchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\009-entitlement-evidence.sql" LogicalName="CloudEntitle.LicenseServer.EntitlementEvidenceSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\010-priority-two.sql" LogicalName="CloudEntitle.LicenseServer.PriorityTwoSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\011-trust-credential-monitoring.sql" LogicalName="CloudEntitle.LicenseServer.TrustCredentialSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\012-break-glass-reports.sql" LogicalName="CloudEntitle.LicenseServer.BreakGlassSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\013-continuous-change-feeds.sql" LogicalName="CloudEntitle.LicenseServer.ContinuousChangeFeedSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\014-authoritative-decisions.sql" LogicalName="CloudEntitle.LicenseServer.AuthoritativeDecisionSchema.sql" />
    <EmbeddedResource Include="..\..\infra\postgres\015-jit-safety-guards.sql" LogicalName="CloudEntitle.LicenseServer.JitSafetyGuardsSchema.sql" />
  </ItemGroup>

  <Target Name="BuildOperationsConsole" BeforeTargets="PrepareForBuild" Condition="'$(BuildWebConsole)' == 'true'">
    <Exec WorkingDirectory="..\CloudEntitle.WebConsole" Command="npm ci" />
    <Exec WorkingDirectory="..\CloudEntitle.WebConsole" Command="npm run build" />
    <ItemGroup>
      <Content Remove="wwwroot\console\**" />
      <Content Include="wwwroot\console\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>

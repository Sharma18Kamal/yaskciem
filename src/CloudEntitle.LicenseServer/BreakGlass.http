@baseUrl = https://license.example.invalid
@organizationId = 00000000-0000-0000-0000-000000000000
@reportId = 11111111-1111-1111-1111-111111111111
@reporterToken = replace-with-delegated-incident-reporter-token
@reviewerToken = replace-with-delegated-configured-security-reviewer-token

### Report client-owned emergency use AFTER connectivity returns; no access or credentials issued.
# Use a unique persisted reportId for safe exact retries; replace dates with a completed interval.
POST {{baseUrl}}/api/v1/organizations/{{organizationId}}/break-glass-reports
Authorization: Bearer {{reporterToken}}
Content-Type: application/json

{
  "reportId": "{{reportId}}",
  "provider": 0,
  "accountId": "22222222-2222-2222-2222-222222222222",
  "externalPrincipal": "33333333-3333-3333-3333-333333333333",
  "startedAtUtc": "2026-11-08T08:00:00Z",
  "endedAtUtc": "2026-11-08T09:00:00Z",
  "reason": "Client emergency runbook used during SSO outage",
  "clientIncidentReference": "INC-12345",
  "activitySnapshotId": null
}

### Saved list, no cloud endpoint connection.
GET {{baseUrl}}/api/v1/organizations/{{organizationId}}/break-glass-reports
Authorization: Bearer {{reporterToken}}

### Scoped selected report (foreign or nonexistent ID returns 404).
GET {{baseUrl}}/api/v1/organizations/{{organizationId}}/break-glass-reports/{{reportId}}
Authorization: Bearer {{reviewerToken}}

### Independent review: reporter cannot review own report; one immutable review.
# This attests CLIENT cleanup/rotation, never provider-verified revocation.
POST {{baseUrl}}/api/v1/organizations/{{organizationId}}/break-glass-reports/{{reportId}}/review
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{
  "reason": "Client security team reviewed cloud activity, access cleanup and emergency credential rotation",
  "clientClosureReference": "CHANGE-54321",
  "clientVerifiedClosure": true
}
